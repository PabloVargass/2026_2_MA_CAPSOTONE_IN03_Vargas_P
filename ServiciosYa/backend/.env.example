# Configurar valores reales en el gestor de secretos del proveedor.
DATABASE_URL=
JWT_SECRET=
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Opcional: servidor SMTP distinto de Gmail (p. ej. smtp-relay.brevo.com, puerto 2525).
# Sin SMTP_HOST se usa Gmail. EMAIL_USER es el remitente; SMTP_USER el usuario de acceso si es distinto.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Opcional: necesario para el inicio de sesión con Google.
GOOGLE_CLIENT_ID=
# El alojamiento suele definir PORT automáticamente.
PORT=3000
# Opcional: orígenes web permitidos por CORS, separados por comas. Sin valor, en desarrollo solo localhost.
CORS_ORIGINS=
# Opcional: "true" cuando la API está detrás de un proxy HTTPS del alojamiento.
TRUST_PROXY=
